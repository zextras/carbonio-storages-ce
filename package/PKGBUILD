targets=(
  "centos"
  "ubuntu"
)
pkgname="carbonio-storages-ce"
pkgver="1.0.2"
pkgrel="1"
pkgdesc="External store for Carbonio CE"
pkgdesclong=(
  "External store for Carbonio CE"
)
arch="amd64"
maintainer="Zextras <packages@zextras.com"
url="https://zextras.com"
section="libs"
priority="important"
depends=(
  "pending-setups"
  "service-discover"
  "jq"
)
sources=(
  "storages-ce.sh"
  "storages-ce.hcl"
  "storages-ce.service"
  "storages-ce-sidecar.service"
)
hashsums=(
  "1d504fcdda279cd7f3bc532c3fa5820fb727b1b653dae567cfd57cf95f00f412"
  "e83c4c17ca4d6b9bb84676baf2a6e4e74a77a8ea67729c7460778aef4f277ba5"
  "b3de776c542be4c938766cdaf4919b7d5d5a24e935fc0c59f55a9055dd4e7039"
  "16005384d619273d5024ca1b67b3cfb3cae05fb289b7f4e6df0c9c0ece15c1f0"
)

build() {
  cd "${srcdir}"/../../project
  npm install
  npm run build
  npm run pkg
}

package:apt() {
  cd "${srcdir}"/../../project

  install -Dm755 "${srcdir}/storages-ce.sh" \
    "${pkgdir}/usr/bin/storages-ce"
  install -Dm755 "${srcdir}/storages-ce.service" \
    "${pkgdir}"/lib/systemd/system/storages-ce.service
  install -Dm755 "${srcdir}/storages-ce-sidecar.service" \
    "${pkgdir}"/lib/systemd/system/storages-ce-sidecar.service
  install -Dm755 storages-ce \
    "${pkgdir}/opt/carbonio/common/bin/storages-ce"
  install -Dm644 "${srcdir}/storages-ce.hcl" \
    "${pkgdir}/etc/zextras/service-discover/storages-ce.hcl"

  mkdir -p "${pkgdir}/etc/zextras/storages"
  cp "src/node/config/config.json" "${pkgdir}/etc/zextras/storages"
  mkdir -p "${pkgdir}/etc/zextras/storages"
}

package:yum() {
  cd "${srcdir}"/../../project

  install -Dm755 "${srcdir}/storages-ce.sh" \
    "${pkgdir}/usr/bin/storages-ce"
  install -Dm755 "${srcdir}/storages-ce.service" \
    "${pkgdir}"/usr/lib/systemd/system/storages-ce.service
  install -Dm755 "${srcdir}/storages-ce-sidecar.service" \
    "${pkgdir}"/usr/lib/systemd/system/storages-ce-sidecar.service
  install -Dm755 storages-ce \
    "${pkgdir}/opt/carbonio/common/bin/storages-ce"
  install -Dm644 "${srcdir}/storages-ce.hcl" \
    "${pkgdir}/etc/zextras/service-discover/storages-ce.hcl"

  mkdir -p "${pkgdir}/etc/zextras/storages"
  cp "src/node/config/config.json" "${pkgdir}/etc/zextras/storages"
  mkdir -p "${pkgdir}/etc/zextras/storages"
}

preinst:apt() {
  if [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop 'storages-ce.service' >/dev/null || true
  fi
}

postinst:apt() {
  if [ "$1" = "configure" ]; then
    # creating zextras group if it isn't already there
    if ! getent group zextras >/dev/null; then
      addgroup --system --force-badname --quiet zextras
    fi

    # creating carbonio-storages user if it isn't already there
    if ! getent passwd carbonio-storages >/dev/null; then
      adduser --system --force-badname --quiet \
        --ingroup zextras \
        --home /opt/zextras \
        --shell /bin/bash \
        carbonio-storages
      usermod -c "zextras user" carbonio-storages
    fi
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable storages-ce.service >/dev/null 2>&1 || :
    systemctl enable storages-ce-sidecar.service >/dev/null 2>&1 || :
  fi
  echo ""
  echo "Only one Storages-CE is allowed in a multiserver environment"
  echo "Installed, you must now run as root:"
  echo "pending-setups"
  cat >/etc/zextras/pending-setups.d/storages-ce-setup.sh <<EOF
#!/usr/bin/env bash
/usr/bin/storages-ce setup
EOF
}

postinst:yum() {
  # creating zextras group if it isn't already there
  if ! getent group carbonio-storages >/dev/null; then
    addgroup --system --force-badname --quiet zextras
  fi
  # creating carbonio-storages user if it isn't already there
  if ! getent passwd carbonio-storages >/dev/null; then
    adduser --system --force-badname --quiet \
      --ingroup zextras \
      --home /opt/zextras \
      --shell /bin/bash \
      carbonio-storages
    usermod -c "zextras user" carbonio-storages
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable storages-ce.service >/dev/null 2>&1 || :
    systemctl enable storages-ce-sidecar.service >/dev/null 2>&1 || :
  fi
  echo ""
  echo "Only one Storages-CE is allowed in a multiserver environment"
  echo "Installed, you must now run as root:"
  echo "pending-setups"
  cat >/etc/zextras/pending-setups.d/storages-ce-setup.sh <<EOF
#!/usr/bin/env bash
storages-ce setup
EOF
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable storages-ce.service >/dev/null 2>&1 || :
    systemctl --no-reload disable storages-ce-sidecar.service >/dev/null 2>&1 || :
    systemctl stop storages-ce.service >/dev/null 2>&1 || :
    systemctl stop storages-ce-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/zextras/pending-setups.d/storages-ce-setup.sh
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
