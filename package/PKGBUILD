pkgname="carbonio-storages-ce"
pkgver="1.0.14"
pkgrel="1"
pkgdesc="External store for Carbonio CE"
arch=('x86_64')
maintainer="Zextras <packages@zextras.com"
url="https://zextras.com"
section="libs"
priority="important"
options=('!strip')
depends=(
  "pending-setups"
  "service-discover"
  "jq"
)
source=(
  "carbonio-storages.sh"
  "carbonio-storages.hcl"
  "carbonio-storages.service"
  "carbonio-storages-sidecar.service"
  "intentions.json"
  "service-protocol.json"
)
sha256sums=('5bf54df7a315ddfa3b13365f7bdc906e401d9895d1402e9f37c18ef9ca381fcf'
  '19b113b2c4ce428514e62c1b06d59d805ae7db05dd2a76a8aac93fe4ac6c9cd6'
  '9ff0d8ca695232fba7ed75b9ed6e6d1f9d38b5c63b90ac7956119db7704bad81'
  'b38474fee46e9ba7b44a54ba4b184e634439c214d81c70b919a2af20778d6c83'
