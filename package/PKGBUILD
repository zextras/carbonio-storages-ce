build() {
  cd "${srcdir}"/../../project
  export PKG_CACHE_PATH="${srcdir}/../../project"
  npm install
  npm run build
  npm run pkg

  # ugly workaround to disable rpm system-wide stripping
  # please don't execute outside of the build agent
  echo "/bin/true" >/usr/bin/strip
}

package() {
  cd "${srcdir}"/../../project
  install -Dm755 "${srcdir}/carbonio-storages.sh" \
    "${pkgdir}/usr/bin/carbonio-storages"
  install -Dm755 "${srcdir}/carbonio-storages.service" \
    "${pkgdir}"/usr/lib/systemd/system/carbonio-storages.service
  install -Dm755 "${srcdir}/carbonio-storages-sidecar.service" \
    "${pkgdir}"/usr/lib/systemd/system/carbonio-storages-sidecar.service
  install -Dm755 carbonio-storages \
    "${pkgdir}/opt/zextras/common/bin/carbonio-storages"
  install -Dm644 "${srcdir}/carbonio-storages.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-storages.hcl"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/storages/service-discover/service-protocol.json"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/storages/service-discover/intentions.json"

  mkdir -p "${pkgdir}/etc/zextras/carbonio-storages"

  mkdir -p "${pkgdir}/etc/carbonio/storages"
  cp "src/node/config/config.json" "${pkgdir}/etc/carbonio/storages"
}

preinst__apt() {
  if [ ! -d /opt/zextras ]; then
    mkdir -p /opt/zextras
  fi
  if [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop 'carbonio-storages.service' >/dev/null || true
  fi
}

postinst__apt() {
  if [ "$1" = "configure" ]; then
    # creating zextras group if it isn't already there
    if ! getent group zextras >/dev/null; then
      addgroup --system --force-badname --quiet zextras
    fi

    # creating carbonio-storages user if it isn't already there
    if ! getent passwd carbonio-storages >/dev/null; then
      adduser --system --force-badname --quiet \
        --ingroup zextras \
        --home /opt/zextras \
        --shell /bin/bash \
        carbonio-storages
      usermod -c "zextras user" carbonio-storages
    fi
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-storages.service >/dev/null 2>&1 || :
    systemctl enable carbonio-storages-sidecar.service >/dev/null 2>&1 || :
  fi
  echo ""
  echo "Only one Storages-CE is allowed in a multiserver environment"
  echo "Installed, you must now run as root:"
  echo "pending-setups"
  cat >/etc/zextras/pending-setups.d/carbonio-storages-setup.sh <<EOF
#!/usr/bin/env bash
/usr/bin/carbonio-storages setup
EOF
}

preinst__yum() {
  if [ ! -d /opt/zextras ]; then
    mkdir -p /opt/zextras
  fi
}

postinst__yum() {
  # creating zextras group if it isn't already there
  if ! getent group zextras >/dev/null; then
    groupadd --system zextras
  fi
  # creating carbonio-storages user if it isn't already there
  if ! getent passwd carbonio-storages >/dev/null; then
    useradd --system \
      --groups zextras \
      --home-dir /opt/zextras \
      --shell /bin/bash \
      carbonio-storages
    usermod -c "zextras user" carbonio-storages
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-storages.service >/dev/null 2>&1 || :
    systemctl enable carbonio-storages-sidecar.service >/dev/null 2>&1 || :
  fi
  echo ""
  echo "Only one Storages-CE is allowed in a multiserver environment"
  echo "Installed, you must now run as root:"
  echo "pending-setups"
  cat >/etc/zextras/pending-setups.d/carbonio-storages-setup.sh <<EOF
#!/usr/bin/env bash
carbonio-storages setup
EOF
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-storages.service >/dev/null 2>&1 || :
    systemctl --no-reload disable carbonio-storages-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-storages.service >/dev/null 2>&1 || :
    systemctl stop carbonio-storages-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/zextras/carbonio-storages/token
  rm -f /etc/zextras/pending-setups.d/carbonio-storages-setup.sh

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
