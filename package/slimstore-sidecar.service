[Unit]
Description=Slimstore sidecar proxy
Documentation=https://docs.zextras.com/zextras-suite-documentation/latest/
Requires=network-online.target
Requires=slimstore.service
After=network-online.target
After=slimstore.service

[Service]
Type=simple
ExecStart=/usr/bin/consul connect envoy \
    -token-file /etc/zextras/slimstore/token \
    -admin-bind localhost:0 \
    -sidecar-for slimstore
Restart=on-failure
RestartSec=15
User=zextras
KillMode=process
KillSignal=SIGKILL
LimitNOFILE=65536
TimeoutSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
