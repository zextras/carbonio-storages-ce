    "tap": "^18.6.1",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "assets": [
      "dist/node/**/*",
      "./node_modules/@sinclair/typebox/build/cjs/type/index.js"
