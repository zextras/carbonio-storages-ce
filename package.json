{
  "name": "carbonio-storages",
  "version": "1.0.0",
  "description": "",
  "bin": "dist/node/index.js",
  "type": "commonjs",
  "devDependencies": {
    "@sinclair/typebox": "^0.20.5",
    "@types/busboy": "^0.2.4",
    "@types/crypto-js": "^4.0.2",
    "@types/node": "^18.11.5",
    "@types/tap": "^15.0.5",
    "fastify": "^3.21.6",
    "pkg": "^5.5.1",
    "rimraf": "^3.0.2",
    "tap": "^15.0.10",
    "ts-node": "^10.2.1",
    "tslint": "^6.1.3",
    "typescript": "^4.4.3"
  },
  "pkg": {
    "assets": [
      "dist/node/**/*"
    ],
    "targets": [
      "node14"
    ]
  },
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "pkg": "pkg -t node14-linux -C Brotli .",
    "start": "STORAGES_LOGGING_DIRNAME=/tmp/storages-ce-log STORAGES_PATH=/tmp/storages-ce-store /bin/node dist/node/index.js",
    "test": "NODE_ENV='test'; NODE_DEBUG=*; tap 'src/test/**/*Test.ts' --no-timeout --node-arg=--loader=ts-node/esm --coverage-report=html --no-browser",
    "test:single": "NODE_ENV='test'; NODE_DEBUG=*; tap --timeout=0 --node-arg=--loader=ts-node/esm --coverage-report=html --no-browser",
    "lint": "tslint --project tsconfig.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "check-disk-space": "^3.0.1",
    "crypto-js": "^4.1.1",
    "fastify-multipart": "^5.0.1",
    "fastify-swagger": "^4.8.3",
    "form-data": "^4.0.0",
    "logging": "^3.3.0",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.5",
    "zlib": "^1.0.5"
  },
  "tap": {
    "branches": 78,
    "lines": 80,
    "functions": 80,
    "statements": 80
  }
}
