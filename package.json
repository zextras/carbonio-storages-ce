{
  "name": "carbonio-storages",
  "version": "1.0.16",
  "description": "",
  "bin": "dist/node/index.js",
  "type": "commonjs",
  "devDependencies": {
    "@sinclair/typebox": "^0.34.48",
    "@types/busboy": "^0.2.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.2.4",
    "@yao-pkg/pkg": "^6.14.1",
    "fastify": "^5.6.1",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "assets": [
      "dist/node/**/*",
      "./node_modules/@sinclair/typebox/build/cjs/type/index.js"
    ],
    "targets": [
      "node22"
    ]
  },
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "pkg": "pkg -t node22-linux -C Brotli .",
    "reset": "node ./scripts/reset.js",
    "start": "STORAGES_LOGGING_DIRNAME=/tmp/storages-ce-log STORAGES_PATH=/tmp/storages-ce-store node dist/node/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:single": "vitest run",
    "lint": "tslint --project tsconfig.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@types/react": "^18.3.28",
    "check-disk-space": "^3.4.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0",
    "logging": "^3.3.0",
    "pino-pretty": "^13.1.2",
    "rotating-file-stream": "^3.2.7",
    "save-dev": "^0.0.1-security"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
