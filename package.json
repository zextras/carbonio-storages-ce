{
  "name": "carbonio-storages",
  "version": "1.0.15",
  "description": "",
  "bin": "dist/node/index.js",
  "type": "commonjs",
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@types/busboy": "^0.2.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.19.3",
    "@types/tap": "^15.0.12",
    "@yao-pkg/pkg": "^6.6.0",
    "fastify": "^5.6.1",
