{
  "name": "carbonio-storages",
  "version": "1.0.17",
  "description": "",
  "bin": "dist/node/index.js",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^10.8.0",
    "form-data": "^4.0.0",
    "light-my-request": "^6.6.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pkg": {
    "assets": [
      "dist/node/**/*",
      "./node_modules/@sinclair/typebox/build/cjs/type/index.js"
    ],
    "targets": [
      "node22"
    ]
  },
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "pkg": "pkg -t node22-linux -C Brotli .",
    "reset": "node ./scripts/reset.js",
    "start": "STORAGES_LOGGING_DIRNAME=/tmp/storages-ce-log STORAGES_PATH=/tmp/storages-ce-store node dist/node/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:single": "vitest run",
    "lint": "eslint src"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.6",
    "ajv": "^8.17.1",
    "check-disk-space": "^3.4.0",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "rotating-file-stream": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.1",
      "postcss": "^8.5.10"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
